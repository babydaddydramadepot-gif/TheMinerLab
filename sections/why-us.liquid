<section class="why-us-section section-spacing">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow">Why Choose Us</span>
      <h2 class="section-title">Why The Miner Lab</h2>
    </div>

    <div class="why-us-grid reveal">
      <div class="why-us-card glass">
        <div class="why-us-card-icon">
          {% render 'icon-shield' %}
        </div>
        <h3 class="why-us-card-title">Verified Surplus Hardware</h3>
        <p class="why-us-card-desc">
          Every unit is genuine manufacturer equipment, sourced from verified surplus channels.
        </p>
      </div>

      <div class="why-us-card glass">
        <div class="why-us-card-icon">
          {% render 'icon-settings' %}
        </div>
        <h3 class="why-us-card-title">Tested & Benchmarked</h3>
        <p class="why-us-card-desc">
          100% tested before shipment. Full hashrate validation and thermal benchmarking included.
        </p>
      </div>

      <div class="why-us-card glass">
        <div class="why-us-card-icon">
          {% render 'icon-truck' %}
        </div>
        <h3 class="why-us-card-title">USA-Based Shipping</h3>
        <p class="why-us-card-desc">
          Fast domestic shipping from our USA warehouse. Most orders ship within 48 hours.
        </p>
      </div>

      <div class="why-us-card glass">
        <div class="why-us-card-icon">
          {% render 'icon-zap' %}
        </div>
        <h3 class="why-us-card-title">Tuned & Ready To Deploy</h3>
        <p class="why-us-card-desc">
          Pre-configured firmware options available. Vnish or Braiins OS ready to mine.
        </p>
      </div>

      <div class="why-us-card glass">
        <div class="why-us-card-icon">
          {% render 'icon-package' %}
        </div>
        <h3 class="why-us-card-title">Wholesale Surplus Inventory</h3>
        <p class="why-us-card-desc">
          Pallet quantities available. Volume pricing for facility deployments.
        </p>
      </div>

      <div class="why-us-card glass">
        <div class="why-us-card-icon">
          {% render 'icon-message' %}
        </div>
        <h3 class="why-us-card-title">Direct Engineer Support</h3>
        <p class="why-us-card-desc">
          Talk directly to mining engineers. Real technical support from people who deploy hardware.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Us",
  "settings": [],
  "presets": [
    {
      "name": "Why Us"
    }
  ]
}
{% endschema %}
