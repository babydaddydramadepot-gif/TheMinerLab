            </svg>
          </div>
          <blockquote class="review-text">
            “Great pricing, fast shipping, and secure packaging. The miner matched the description perfectly and the entire buying process was smooth.”
          </blockquote>
          <div class="review-author">
            <div class="review-avatar">DR</div>
            <div>
              <p class="review-name">Daniel R.</p>
              <p class="review-role">Verified Buyer</p>
            </div>
            <div class="review-verified">Verified Purchase</div>
          </div>
        </div>

        <div class="review-card glass">
          <div class="review-stars">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
