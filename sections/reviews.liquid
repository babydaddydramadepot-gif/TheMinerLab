              <path d="M8 .5l2.06 5.28 5.69.42-4.38 3.69 1.33 5.61L8 12.5l-4.7 3-1.33-5.61L.5 6.2l5.69-.42L8 .5z"/>
            </svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 .5l2.06 5.28 5.69.42-4.38 3.69 1.33 5.61L8 12.5l-4.7 3-1.33-5.61L.5 6.2l5.69-.42L8 .5z"/>
            </svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
