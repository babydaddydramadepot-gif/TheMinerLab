<section class="reviews-section section-spacing">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow">Customer Voices</span>
      <h2 class="section-title">What Our Customers Say</h2>
    </div>

    <div class="reviews-carousel reveal">
      <button class="reviews-nav-btn reviews-prev" aria-label="Previous reviews">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="reviews-scroller">
        <div class="review-card glass">
          <div class="review-stars">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 .5l2.06 5.28 5.69.42-4.38 3.69 1.33 5.61L8 12.5l-4.7 3-1.33-5.61L.5 6.2l5.69-.42L8 .5z"/>
