<section class="page-404 section-spacing">
  <div class="container">
    <div class="page-404-content">
      <div class="page-404-icon">
        <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="50" stroke="currentColor" stroke-width="2" opacity="0.3"/>
          <path d="M40 50L50 60L40 70M70 50L80 60L70 70" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <path d="M50 85H70" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </div>
      <h1 class="page-404-title">404</h1>
      <h2 class="page-404-heading">Page Not Found</h2>
      <p class="page-404-text">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="page-404-actions">
        <a href="/" class="btn btn-premium">Back to Home</a>
        <a href="/collections/all" class="btn btn-secondary">Shop Miners</a>
      </div>
    </div>
  </div>
</section>

