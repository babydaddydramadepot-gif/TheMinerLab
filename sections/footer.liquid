<footer class="site-footer">
  {% assign asic_collection = collections['asic-miners'] %}
  {% assign power_collection = collections['power-supplies'] %}
  {% assign loki_collection = collections['loki-kits'] %}
  {% assign accessories_collection = collections['accessories'] %}
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" style="display:flex;align-items:center;gap:0.6rem;font-family:var(--font-display);font-size:1.1rem;font-weight:700;text-decoration:none;color:inherit;margin-bottom:1rem;">
          {% render 'icon-cpu' %}
          <span>THE MINER <span style="color:var(--primary)">LAB</span></span>
        </a>
        <p style="font-size:0.875rem;line-height:1.6;max-width:280px;">
          Tested ASIC miners, tuned systems and mining infrastructure built for serious operators. USA-based shipping, quality guaranteed.
        </p>
        <form class="footer-newsletter" action="/pages/contact#newsletter" method="post">
          <input
            type="email"
            name="contact[email]"
            placeholder="your@email.com"
            required
            class="form-input"
            style="padding:0.6rem 0.75rem;font-size:0.875rem;"
            aria-label="Email address"
          >
          <button type="submit" class="btn btn-premium btn-sm" aria-label="Subscribe">Subscribe</button>
        </form>
      </div>

      <div class="footer-links">
        <h4>Shop</h4>
        <ul>
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="{% if asic_collection != blank %}{{ asic_collection.url }}{% else %}/collections/all?category=asic-miners{% endif %}">ASIC Miners</a></li>
          <li><a href="{% if power_collection != blank %}{{ power_collection.url }}{% else %}/collections/all?category=power-supplies{% endif %}">Power Supplies</a></li>
          <li><a href="{% if loki_collection != blank %}{{ loki_collection.url }}{% else %}/collections/all?category=loki-kits{% endif %}">Loki Kits</a></li>
          <li><a href="{% if accessories_collection != blank %}{{ accessories_collection.url }}{% else %}/collections/all?category=accessories{% endif %}">Accessories</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Company</h4>
        <ul>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/wholesale">Wholesale</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Contact</h4>
        <ul>
          <li>
            <a href="mailto:{{ settings.social_email | default: 'sales@theminerlab.com' }}">
              {{ settings.social_email | default: 'sales@theminerlab.com' }}
            </a>
          </li>
          <li>Mon&ndash;Fri &middot; 9AM&ndash;5PM CST</li>
        </ul>
        <div class="social-links" style="margin-top:1.25rem;">
          {% if settings.social_twitter != blank %}
            <a href="{{ settings.social_twitter }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter" title="Twitter">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.073 4.073 0 01.8 7.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 010 16.407a11.616 11.616 0 006.29 1.84"/></svg>
            </a>
          {% endif %}
          {% if settings.social_youtube != blank %}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M19.615 5.481A2.5 2.5 0 0017.86 3.73C16.308 3.333 10 3.333 10 3.333s-6.308 0-7.86.397a2.5 2.5 0 00-1.755 1.75C0 7.034 0 10.267 0 10.267s0 3.233.385 4.786a2.5 2.5 0 001.755 1.75c1.552.397 7.86.397 7.86.397s6.308 0 7.86-.397a2.5 2.5 0 001.755-1.75c.385-1.553.385-4.786.385-4.786s0-3.233-.385-4.786zM8 13.4V7.133L13.2 10.267 8 13.4z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="footer-bottom" style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;">
      <p style="margin:0;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <p style="font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;margin:0;">USA-BASED &middot; TESTED &middot; TUNED &middot; DEPLOYED</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
